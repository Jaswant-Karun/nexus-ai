{
  "name": "NEXUS AI - Multi-Agent Collaboration Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nexus-multi-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "id": "webhook-trigger",
      "name": "Multi-Agent Trigger"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nreturn {\n  goal: body.goal || 'Analyze platform security and data architecture',\n  agents: body.agents || ['analyst', 'security', 'synthesizer'],\n  organizationId: body.organizationId || 'default'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 300],
      "id": "init-goal",
      "name": "Initialize Goal"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: Data Analyst Agent\nGoal: {{ $json.goal }}\nTask: Analyze data trends, storage metrics, and quantitative implications. Return a 3-bullet data summary.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 180],
      "id": "agent-analyst",
      "name": "Agent 1: Data Analyst"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [440, 20],
      "id": "groq-chat-model",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: Security & Architecture Auditor\nGoal: {{ $json.goal }}\nTask: Review security policies, encryption levels (AES-256, TLS 1.3), and compliance considerations. Return a 3-bullet security audit.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 420],
      "id": "agent-security",
      "name": "Agent 2: Security Auditor"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [440, 600],
      "id": "gemini-chat-model",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll"
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [740, 300],
      "id": "merge-agents",
      "name": "Consolidate Outputs"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Synthesize the findings from our specialist agents into a final executive deliverable.\n\nAgent Findings:\n{{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "You are the Lead Synthesizer for NEXUS AI. Consolidate agent reports into an executive-ready action plan with high clarity."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [980, 300],
      "id": "agent-synthesizer",
      "name": "Agent 3: Lead Synthesizer"
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [980, 500],
      "id": "openai-chat-model-synthesizer",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"workflow\": \"Multi-Agent Collaboration\",\n  \"finalReport\": {{ JSON.stringify($json.output || $json.text || $json) }},\n  \"completedAt\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1220, 300],
      "id": "return-response",
      "name": "Return Final Report"
    }
  ],
  "connections": {
    "Multi-Agent Trigger": {
      "main": [
        [
          {
            "node": "Initialize Goal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Goal": {
      "main": [
        [
          {
            "node": "Agent 1: Data Analyst",
            "type": "main",
            "index": 0
          },
          {
            "node": "Agent 2: Security Auditor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Agent 1: Data Analyst",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Agent 2: Security Auditor",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Agent 1: Data Analyst": {
      "main": [
        [
          {
            "node": "Consolidate Outputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent 2: Security Auditor": {
      "main": [
        [
          {
            "node": "Consolidate Outputs",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Consolidate Outputs": {
      "main": [
        [
          {
            "node": "Agent 3: Lead Synthesizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Agent 3: Lead Synthesizer",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Agent 3: Lead Synthesizer": {
      "main": [
        [
          {
            "node": "Return Final Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
