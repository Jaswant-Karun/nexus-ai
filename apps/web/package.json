{
  "name": "@nexus-ai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "jobs:process": "tsx scripts/process-ai-jobs.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --schema=prisma/schema.prisma --force-reset && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nexus/auth": "workspace:*",
    "@nexus/config": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/types": "workspace:*",
    "@nexus/ui": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.41.0",
    "mammoth": "^1.12.3",
    "next": "15.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.0",
    "postcss": "8.4.49",
    "prisma": "^7.9.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.7.2"
  }
}
